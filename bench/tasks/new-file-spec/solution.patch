@@ -0,0 +1,16 @@
+def render_table(rows, headers):
+    def fmt(cells):
+        return "| " + " | ".join(str(c) for c in cells) + " |"
+
+    lines = [fmt(headers)]
+    lines += [fmt([row.get(h, "") for h in headers]) for row in rows]
+    width = max(len(line) for line in lines)
+    border = "+" + "-" * (width - 2) + "+"
+
+    out = [border]
+    for i, line in enumerate(lines):
+        out.append(line[:-1].ljust(width - 1) + "|")
+        if i == 0:
+            out.append(border)
+    out.append(border)
+    return "\n".join(out)
